        {
          "name": "Retirar asignación ANALYST",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if(!pm.environment.get('analystAssignmentId')){pm.sendRequest({url:pm.environment.get('authUrl')+'/api/user-roles',method:'GET',header:{Authorization:'Bearer '+pm.environment.get('adminJwt')}},(err,res)=>{if(err)throw err;const a=res.json().find(x=>x.user?.username==='analyst'&&x.role?.rol==='ANALYST');if(!a)throw new Error('No se encontró la asignación ANALYST');pm.environment.set('analystAssignmentId',a.id);});}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('asignación retirada',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminJwt}}"
              }
            ],
            "url": "{{authUrl}}/api/user-roles/{{analystAssignmentId}}"
          }
        },
        {
          "name": "Revocado: reutilizar mismo JWT ANALYST → 403",
          "description": "No vuelva a iniciar sesión entre retirar la asignación y esta solicitud.",
          "event": [
