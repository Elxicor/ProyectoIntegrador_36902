            ],
            "url": "{{authUrl}}/api/users",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cedula\": \"3333333333\",\n  \"nombres\": \"Usuario\",\n  \"apellidos\": \"Evaluacion\",\n  \"fechaNacimiento\": \"1995-01-01\",\n  \"username\": \"evaluador_demo\",\n  \"email\": \"evaluador_demo@example.local\",\n  \"password\": \"Evaluador-Pass-2026!\"\n}",
