{
  "info": {
    "name": "AUTH–STEGO | Sustentación de seguridad",
    "description": "AUTH–STEGO. Colección de evaluación: login, gestión N:M, JWT, análisis de imágenes, autorización, revocación, pruebas de archivos y consultas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01. Sesiones",
      "item": [
        {
          "name": "Login ADMIN",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 y JWT',()=>pm.response.to.have.status(201));",
                  "const j=pm.response.json(); pm.environment.set('adminJwt',j.access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"identity\":\"{{adminIdentity}}\",\"password\":\"{{adminPassword}}\"}"
            },
            "url": "{{authUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login ANALYST",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 y JWT',()=>pm.response.to.have.status(201));",
                  "pm.environment.set('analystJwt',pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"identity\":\"{{analystIdentity}}\",\"password\":\"{{analystPassword}}\"}"
            },
            "url": "{{authUrl}}/api/auth/login"
          }
        },
        {
          "name": "Login USER",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 y JWT',()=>pm.response.to.have.status(201));",
                  "pm.environment.set('userJwt',pm.response.json().access_token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"identity\":\"{{userIdentity}}\",\"password\":\"{{userPassword}}\"}"
            },
            "url": "{{authUrl}}/api/auth/login"
          }
        },
        {
          "name": "Inspeccionar JWT (RS256, sin roles)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const t=pm.environment.get('analystJwt'); const [h,p]=t.split('.');",
                  "const d=s=>JSON.parse(atob(s.replace(/-/g,'+').replace(/_/g,'/'))); const header=d(h), payload=d(p);",
                  "console.log({header,payload}); pm.test('alg RS256',()=>pm.expect(header.alg).to.eql('RS256'));",
                  "pm.test('payload sin roles',()=>pm.expect(payload).not.to.have.property('roles'));",
                  "pm.test('claims de seguridad',()=>{pm.expect(payload).to.include.all.keys('sub','exp','iss','aud','typ','tokenVersion');});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{analystJwt}}"
              }
            ],
            "url": "{{authUrl}}/api/auth/profile"
          }
        }
      ]
    },
    {
      "name": "02. Firma y claims",
      "item": [
        {
          "name": "STEGO sin token → 401",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{normalPng}}"
                }
              ]
            },
            "url": "{{stegoUrl}}/api/steganography/analyze"
          }
        },
        {
          "name": "JWT manipulado (username + rol falso) → 401",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const t=pm.environment.get('analystJwt').split('.'); const b=s=>JSON.parse(atob(s.replace(/-/g,'+').replace(/_/g,'/')));",
                  "const p=b(t[1]); p.username='atacante'; p.roles=['ADMIN'];",
                  "const enc=o=>btoa(JSON.stringify(o)).replace(/=/g,'').split('+').join('-').split('/').join('_');",
                  "pm.variables.set('tamperedJwt',t[0]+'.'+enc(p)+'.'+t[2]);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401 por firma inválida',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tamperedJwt}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{normalPng}}"
                }
              ]
            },
            "url": "{{stegoUrl}}/api/steganography/analyze"
          }
        },
        {
          "name": "JWT expirado → 401",
          "description": "Genere expiredJwt localmente con auth/scripts/create-expired-token.mjs; nunca use jwt.io.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('401',()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{expiredJwt}}"
              }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{normalPng}}"
                }
              ]
            },
            "url": "{{stegoUrl}}/api/steganography/analyze"
          }
        }
      ]
    },
