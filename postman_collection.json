            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 usuario, o 409 si ya existe',()=>pm.expect([201,409]).to.include(pm.response.code));",
                  "if(pm.response.code===201)pm.environment.set('evaluatorUserId',pm.response.json().id);"
                ]
              }
            }
          ],
          "description": "En nuevas instalaciones devuelve 201; ejecuciones repetidas devuelven 409 por unicidad."
        },
        {
          "name": "Consultar usuario por UUID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminJwt}}"
              }
            ],
            "url": "{{authUrl}}/api/users/{{analystUserId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 usuario',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar usuario de evaluación",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminJwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/users/{{evaluatorUserId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombres\": \"Usuario actualizado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "if(!pm.environment.get('evaluatorUserId')){pm.sendRequest({url:pm.environment.get('authUrl')+'/api/users',method:'GET',header:{Authorization:'Bearer '+pm.environment.get('adminJwt')}},(err,res)=>{if(err)throw err;const u=res.json().find(x=>x.username==='evaluador_demo');if(!u)throw new Error('No se encontró evaluador_demo');pm.environment.set('evaluatorUserId',u.id);});}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 actualización',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Actualizar descripción del rol ANALYST",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminJwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/roles/{{analystRoleId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Análisis de imágenes LSB\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 actualización de rol',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Asignar ANALYST al usuario de evaluación",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminJwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/user-roles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{evaluatorUserId}}\",\n  \"roleId\": \"{{analystRoleId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('201 asociación o 409 existente',()=>pm.expect([201,409]).to.include(pm.response.code));",
                  "if(pm.response.code===201)pm.environment.set('evaluatorAssignmentId',pm.response.json().id);else if(pm.response.code===409){pm.sendRequest({url:pm.environment.get('authUrl')+'/api/user-roles',method:'GET',header:{Authorization:'Bearer '+pm.environment.get('adminJwt')}},(err,res)=>{if(err)throw err;const a=res.json().find(x=>x.userId===pm.environment.get('evaluatorUserId')&&x.roleId===pm.environment.get('analystRoleId'));if(!a)throw new Error('No se encontró la asignación de evaluación');pm.environment.set('evaluatorAssignmentId',a.id);});}"
                ]
              }
            }
          ]
        },
        {
          "name": "Repetir asignación → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminJwt}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{authUrl}}/api/user-roles",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{evaluatorUserId}}\",\n  \"roleId\": \"{{analystRoleId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('409 duplicado',()=>pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Eliminar asignación del usuario de evaluación",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminJwt}}"
              }
            ],
            "url": "{{authUrl}}/api/user-roles/{{evaluatorAssignmentId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 relación eliminada',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "08. Práctica de esteganografía",
      "item": [
        {
          "name": "Analizar imagen original (sin indicios)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminJwt}}"
              }
            ],
            "url": "{{stegoUrl}}/api/steganography/analyze",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{normalPng}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
                  "if(pm.response.code===201) pm.environment.set('lastAnalysisId',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Analizar imagen LSB (sospechosa)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminJwt}}"
              }
            ],
            "url": "{{stegoUrl}}/api/steganography/analyze",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{stegoPng}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
                  "if(pm.response.code===201) pm.environment.set('lastStegoAnalysisId',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Analizar imagen no concluyente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminJwt}}"
              }
            ],
            "url": "{{stegoUrl}}/api/steganography/analyze",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "samples/stego/lsb-inconclusive-pattern.png"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('HTTP 201',()=>pm.response.to.have.status(201));",
                  "if(pm.response.code===201) pm.environment.set('lastInconclusiveAnalysisId',pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Recuperar resultado almacenado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminJwt}}"
              }
            ],
            "url": "{{stegoUrl}}/api/steganography/results/{{lastAnalysisId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 resultado persistido',()=>pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
